string wall_plan_name
bool reset_plan
---
bool success
bool has_task
string task_id
string target_block_id
string reference_block_id
geometry_msgs/PoseStamped pickup_pose
# Pre-pick pose: straight above the pickup by the configured approach height.
geometry_msgs/PoseStamped pickup_approach_pose
geometry_msgs/PoseStamped target_pose
geometry_msgs/PoseStamped reference_pose
# Pre-place pose: above the target and offset laterally along the wall build
# direction (away from the already-placed neighbour), so descending from here to
# target_pose gives an angled approach with clearance.
geometry_msgs/PoseStamped approach_pose
string message
