# Control the active wall-assembly plan in the world model.
#
# command:
#   "list"     - return the available plan names (from currently loaded plans)
#   "reload"   - (re)load plans from wall_plans_file (or the current file if
#                empty), then return the plan names
#   "activate" - clear existing goals and publish wall_plan_name's goals to the
#                world model (forces a fresh publish even if already active)
#   "clear"    - clear all assembly goals from the world model
string command
string wall_plan_name
string wall_plans_file   # optional path for "reload"
---
bool success
string[] plan_names     # populated for "list"/"reload"
string active_plan       # currently activated plan ("" if none)
string wall_plans_file   # file the server currently has loaded
uint32 num_goals         # goals published ("activate") or cleared ("clear")
string message
